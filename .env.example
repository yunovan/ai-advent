# Copy this file to ".env" in the project root and put your OpenRouter key there.
# .env is gitignored and is not committed.
#
# IntelliJ alternative: Run → Edit Configurations → Environment variables
# LLM_API_KEY=sk-or-v1-your-key

LLM_API_KEY=sk-or-v1-your-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Day 5: weak / medium / strong (HuggingFace-origin models via OpenRouter)
# DAY5_WEAK_MODEL=meta-llama/llama-3.2-3b-instruct
# DAY5_MEDIUM_MODEL=qwen/qwen-2.5-7b-instruct
# DAY5_STRONG_MODEL=meta-llama/llama-3.3-70b-instruct

# Day 7: dialogs are saved as JSON files in this directory
# DAY7_DIALOG_DIR=data/day7-dialogs

# Day 8: dialogs with token accounting - model context window (tokens), price per 1M tokens
# DAY8_DIALOG_DIR=data/day8-dialogs
# DAY8_CONTEXT_LIMIT=128000
# DAY8_INPUT_PRICE=0.15
# DAY8_OUTPUT_PRICE=0.60

# Day 9: context management with rolling history compression
# DAY9_DIALOG_DIR=data/day9-dialogs
# DAY9_CONTEXT_LIMIT=128000
# DAY9_INPUT_PRICE=0.15
# DAY9_OUTPUT_PRICE=0.60
# DAY9_RECENT_MESSAGES=10
# DAY9_CHUNK_SIZE=10

# Day 10: three context strategies (Sliding Window / Sticky Facts / Branching)
# DAY10_DIALOG_DIR=data/day10-dialogs
# DAY10_CONTEXT_LIMIT=128000
# DAY10_INPUT_PRICE=0.15
# DAY10_OUTPUT_PRICE=0.60
# DAY10_DEFAULT_WINDOW=8

# Day 11: agent memory layers (short-term / working / long-term)
# DAY11_DIALOG_DIR=data/day11-dialogs
# DAY11_MEMORY_DIR=data/day11-memory
# DAY11_CONTEXT_LIMIT=128000
# DAY11_INPUT_PRICE=0.15
# DAY11_OUTPUT_PRICE=0.60
# DAY11_SHORT_TERM_WINDOW=10

# Day 12: user profile personalization on top of the memory model
# DAY12_DIALOG_DIR=data/day12-dialogs
# DAY12_PROFILE_DIR=data/day12-profiles
# DAY12_MEMORY_DIR=data/day12-memory
# DAY12_CONTEXT_LIMIT=128000
# DAY12_INPUT_PRICE=0.15
# DAY12_OUTPUT_PRICE=0.60
# DAY12_SHORT_TERM_WINDOW=10

# Day 13: task state machine (planning → execution → validation → done)
# DAY13_TASK_DIR=data/day13-tasks
# DAY13_CONTEXT_LIMIT=128000
# DAY13_INPUT_PRICE=0.15
# DAY13_OUTPUT_PRICE=0.60
# DAY13_SHORT_TERM_WINDOW=10

# Day 14: project invariants and state constraints
# DAY14_INVARIANT_DIR=data/day14-invariants
# DAY14_CONTEXT_LIMIT=128000
# DAY14_INPUT_PRICE=0.15
# DAY14_OUTPUT_PRICE=0.60
# DAY14_SHORT_TERM_WINDOW=10

# Day 15: controlled task state transitions
# DAY15_TASK_DIR=data/day15-tasks
# DAY15_CONTEXT_LIMIT=128000
# DAY15_INPUT_PRICE=0.15
# DAY15_OUTPUT_PRICE=0.60
# DAY15_SHORT_TERM_WINDOW=10

# Day 16: MCP server + client integration (server starts with the app)
# DAY16_SERVER_PORT=8090
# DAY16_PATH=/mcp
# DAY16_NAME=ai-advent-mcp
# DAY16_VERSION=0.1.0

# Day 17: own MCP tool "tracker" (mock Яндекс.Трекер) + agent that calls it
# DAY17_SERVER_PORT=9090
# DAY17_PATH=/mcp
# DAY17_NAME=ai-advent-tracker-mcp
# DAY17_VERSION=0.1.0
# DAY17_STORE_DIR=data/day17-tasks
