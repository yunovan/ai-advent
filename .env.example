# Copy this file to ".env" in the project root and put your OpenRouter key there.
# .env is gitignored and is not committed.
#
# IntelliJ alternative: Run → Edit Configurations → Environment variables
# LLM_API_KEY=sk-or-v1-your-key

LLM_API_KEY=sk-or-v1-your-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Day 5: weak / medium / strong (HuggingFace-origin models via OpenRouter)
# DAY5_WEAK_MODEL=meta-llama/llama-3.2-3b-instruct
# DAY5_MEDIUM_MODEL=qwen/qwen-2.5-7b-instruct
# DAY5_STRONG_MODEL=meta-llama/llama-3.3-70b-instruct

# Day 7: dialogs are saved as JSON files in this directory
# DAY7_DIALOG_DIR=data/day7-dialogs

# Day 8: dialogs with token accounting - model context window (tokens), price per 1M tokens
# DAY8_DIALOG_DIR=data/day8-dialogs
# DAY8_CONTEXT_LIMIT=128000
# DAY8_INPUT_PRICE=0.15
# DAY8_OUTPUT_PRICE=0.60

# Day 9: context management with rolling history compression
# DAY9_DIALOG_DIR=data/day9-dialogs
# DAY9_CONTEXT_LIMIT=128000
# DAY9_INPUT_PRICE=0.15
# DAY9_OUTPUT_PRICE=0.60
# DAY9_RECENT_MESSAGES=10
# DAY9_CHUNK_SIZE=10

# Day 10: three context strategies (Sliding Window / Sticky Facts / Branching)
# DAY10_DIALOG_DIR=data/day10-dialogs
# DAY10_CONTEXT_LIMIT=128000
# DAY10_INPUT_PRICE=0.15
# DAY10_OUTPUT_PRICE=0.60
# DAY10_DEFAULT_WINDOW=8
