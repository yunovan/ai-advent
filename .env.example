# Copy this file to ".env" in the project root and put your OpenRouter key there.
# .env is gitignored and is not committed.
#
# IntelliJ alternative: Run → Edit Configurations → Environment variables
# LLM_API_KEY=sk-or-v1-your-key

LLM_API_KEY=sk-or-v1-your-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Day 5: weak / medium / strong (HuggingFace-origin models via OpenRouter)
# DAY5_WEAK_MODEL=meta-llama/llama-3.2-3b-instruct
# DAY5_MEDIUM_MODEL=qwen/qwen-2.5-7b-instruct
# DAY5_STRONG_MODEL=meta-llama/llama-3.3-70b-instruct

# Day 7: dialogs are saved as JSON files in this directory
# DAY7_DIALOG_DIR=data/day7-dialogs

# Day 8: dialogs with token accounting - model context window (tokens), price per 1M tokens
# DAY8_DIALOG_DIR=data/day8-dialogs
# DAY8_CONTEXT_LIMIT=128000
# DAY8_INPUT_PRICE=0.15
# DAY8_OUTPUT_PRICE=0.60

# Day 9: context management with rolling history compression
# DAY9_DIALOG_DIR=data/day9-dialogs
# DAY9_CONTEXT_LIMIT=128000
# DAY9_INPUT_PRICE=0.15
# DAY9_OUTPUT_PRICE=0.60
# DAY9_RECENT_MESSAGES=10
# DAY9_CHUNK_SIZE=10

# Day 10: three context strategies (Sliding Window / Sticky Facts / Branching)
# DAY10_DIALOG_DIR=data/day10-dialogs
# DAY10_CONTEXT_LIMIT=128000
# DAY10_INPUT_PRICE=0.15
# DAY10_OUTPUT_PRICE=0.60
# DAY10_DEFAULT_WINDOW=8

# Day 11: agent memory layers (short-term / working / long-term)
# DAY11_DIALOG_DIR=data/day11-dialogs
# DAY11_MEMORY_DIR=data/day11-memory
# DAY11_CONTEXT_LIMIT=128000
# DAY11_INPUT_PRICE=0.15
# DAY11_OUTPUT_PRICE=0.60
# DAY11_SHORT_TERM_WINDOW=10

# Day 12: user profile personalization on top of the memory model
# DAY12_DIALOG_DIR=data/day12-dialogs
# DAY12_PROFILE_DIR=data/day12-profiles
# DAY12_MEMORY_DIR=data/day12-memory
# DAY12_CONTEXT_LIMIT=128000
# DAY12_INPUT_PRICE=0.15
# DAY12_OUTPUT_PRICE=0.60
# DAY12_SHORT_TERM_WINDOW=10

# Day 13: task state machine (planning → execution → validation → done)
# DAY13_TASK_DIR=data/day13-tasks
# DAY13_CONTEXT_LIMIT=128000
# DAY13_INPUT_PRICE=0.15
# DAY13_OUTPUT_PRICE=0.60
# DAY13_SHORT_TERM_WINDOW=10

# Day 14: project invariants and state constraints
# DAY14_INVARIANT_DIR=data/day14-invariants
# DAY14_CONTEXT_LIMIT=128000
# DAY14_INPUT_PRICE=0.15
# DAY14_OUTPUT_PRICE=0.60
# DAY14_SHORT_TERM_WINDOW=10

# Day 15: controlled task state transitions
# DAY15_TASK_DIR=data/day15-tasks
# DAY15_CONTEXT_LIMIT=128000
# DAY15_INPUT_PRICE=0.15
# DAY15_OUTPUT_PRICE=0.60
# DAY15_SHORT_TERM_WINDOW=10

# Day 16: MCP server + client integration (server starts with the app)
# DAY16_SERVER_PORT=8090
# DAY16_PATH=/mcp
# DAY16_NAME=ai-advent-mcp
# DAY16_VERSION=0.1.0

# Day 17: own MCP tool "tracker" (mock Яндекс.Трекер) + agent that calls it
# DAY17_SERVER_PORT=9090
# DAY17_PATH=/mcp
# DAY17_NAME=ai-advent-tracker-mcp
# DAY17_VERSION=0.1.0
# DAY17_STORE_DIR=data/day17-tasks

# Day 18: scheduler and background jobs (reminders, periodic collection, regular summaries)
# DAY18_SERVER_PORT=9091
# DAY18_PATH=/mcp
# DAY18_NAME=ai-advent-scheduler-mcp
# DAY18_VERSION=0.1.0
# DAY18_STORE_DIR=data/day18-scheduler
# DAY18_TICK_MILLIS=500

# Day 19: composition of MCP tools (search -> summarize -> saveToFile pipeline)
# DAY19_SERVER_PORT=9092
# DAY19_PATH=/mcp
# DAY19_NAME=ai-advent-pipeline-mcp
# DAY19_VERSION=0.1.0
# DAY19_STORE_DIR=data/day19-market

# Day 20: orchestration of several MCP servers (scheduler + market), routing and long cross-server flows
# DAY20_SERVER_PORT=9093
# DAY20_PATH=/mcp
# DAY20_NAME=ai-advent-orchestrator-mcp
# DAY20_VERSION=0.1.0

# Day 21: document indexing (chunking -> embeddings -> JSON index), two chunking strategies compared
# DAY21_SERVER_PORT=9094
# DAY21_PATH=/mcp
# DAY21_NAME=ai-advent-index-mcp
# DAY21_VERSION=0.1.0
# DAY21_STORE_DIR=data/day21-index
# DAY21_CORPUS_DIR=data/day21-corpus
# DAY21_CHUNK_SIZE=600
# DAY21_CHUNK_OVERLAP=80
# DAY21_DIMENSIONS=512

# Day 22: first RAG query (question -> retrieve chunks -> context + question -> LLM), modes with/without RAG
# DAY22_STRATEGY=fixed
# DAY22_TOP_K=5
# DAY22_ANSWER_MAX_TOKENS=400

# Day 23: reranking and filtering (retrieve -> rerank -> relevance threshold filter), query rewrite, mode comparison
# DAY23_STRATEGY=fixed
# DAY23_TOP_K_BEFORE=10
# DAY23_TOP_K_AFTER=5
# DAY23_THRESHOLD=0.5
# DAY23_REWRITE=true
# DAY23_ANSWER_MAX_TOKENS=400

# Day 24: quotes, sources and anti-hallucination (mandatory answer + sources + verbatim quotes, unknown mode when evidence is weak)
# DAY24_STRATEGY=fixed
# DAY24_TOP_K_BEFORE=10
# DAY24_TOP_K_AFTER=5
# DAY24_THRESHOLD=0.5
# DAY24_UNKNOWN_THRESHOLD=0.32
# DAY24_REWRITE=true
# DAY24_QUOTES_PER_SOURCE=3
# DAY24_QUOTE_MIN_CHARS=24
# DAY24_SUPPORT_THRESHOLD=0.35
# DAY24_ANSWER_MAX_TOKENS=400
# Day 25: mini-chat with RAG + task memory (history per session, sources on every turn, unknown mode)
# DAY25_STRATEGY=fixed
# DAY25_TOP_K_BEFORE=10
# DAY25_TOP_K_AFTER=5
# DAY25_THRESHOLD=0.5
# DAY25_UNKNOWN_THRESHOLD=0.32
# DAY25_REWRITE=true
# DAY25_QUOTES_PER_SOURCE=3
# DAY25_QUOTE_MIN_CHARS=24
# DAY25_SUPPORT_THRESHOLD=0.35
# DAY25_ANSWER_MAX_TOKENS=400
# DAY25_HISTORY_LIMIT=40
# DAY25_MAX_SESSIONS=200
# DAY25_MEMORY_TERMS_LIMIT=8
# DAY25_STORE_DIR=data/day25-chat
# Day 26: local LLM via Ollama (localhost:11434, model qwen2.5:3b)
# DAY26_ENDPOINT=http://localhost:11434
# DAY26_MODEL=qwen2.5:3b
# DAY26_CONNECT_TIMEOUT_MS=3000
# DAY26_READ_TIMEOUT_MS=180000
# DAY26_TEMPERATURE=0.2
# DAY26_MAX_TOKENS=300
# Day 27: local assistant - chat on local LLM without cloud models
# DAY27_SYSTEM_PROMPT=
# DAY27_HISTORY_LIMIT=40
# DAY27_MAX_SESSIONS=50
# DAY27_STORE_DIR=data/day27-assistant

# Day 28: local LLM + RAG (retrieval from day 21, generation on local Ollama, cloud only for comparison)
# DAY28_STRATEGY=fixed
# DAY28_TOP_K_BEFORE=10
# DAY28_TOP_K_AFTER=5
# DAY28_THRESHOLD=0.5
# DAY28_REWRITE=true
# DAY28_ANSWER_MAX_TOKENS=400
# DAY28_EVALUATE_RUNS=2

# День 29: оптимизация локальной LLM
# DAY29_BENCHMARK_RUNS=1
# DAY29_QUESTIONS_LIMIT=10
# DAY29_TUNED_TEMPERATURE=0.1
# DAY29_TUNED_NUM_CTX=2048
# DAY29_TUNED_NUM_PREDICT=240

# День 30: локальная LLM как приватный сервис (HTTP API + чат, rate limit, лимит контекста)
# DAY30_HOST=localhost
# DAY30_PORT=8080
# DAY30_API_KEY=
# DAY30_SYSTEM_PROMPT=
# DAY30_MAX_MESSAGES=12
# DAY30_MAX_PROMPT_CHARS=6000
# DAY30_RATE_LIMIT_PER_MINUTE=10
# DAY30_MAX_CONCURRENT=4
# DAY30_MAX_SESSIONS=50
# DAY30_STRESS_REQUESTS=6
# DAY30_STRESS_CONCURRENCY=3
# DAY30_TEMPERATURE=0.2
# DAY30_MAX_TOKENS=300